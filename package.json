{
    "name": "iobroker.flow",
    "version": "0.0.1",
    "description": "Configurable flow diagram for energy, water, gas and heat, for ioBroker.vis-2 and ioBroker.devices",
    "author": "bluefox <dogafox@gmail.com>",
    "contributors": [
        "bluefox <dogafox@gmail.com>"
    ],
    "homepage": "https://github.com/ioBroker/ioBroker.flow",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.flow"
    },
    "keywords": [
        "ioBroker",
        "visualisation",
        "energy",
        "flow",
        "photovoltaics",
        "vis-2",
        "devices"
    ],
    "workspaces": [
        "src-widgets",
        "src-dm-widgets",
        "src-admin",
        "src-preview"
    ],
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@emotion/react": "^11.14.0",
        "@iobroker/build-tools": "^3.0.3",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/gui-components": "^10.3.7",
        "@iobroker/testing": "^6.3.0",
        "@iobroker/types": "^7.2.3",
        "@iobroker/types-vis-2": "~2.20.1",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@mui/system": "^9.4.0",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3"
    },
    "files": [
        "admin/",
        "widgets/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsx tasks.ts",
        "build-vis": "tsx tasks.ts --vis",
        "build-dm": "tsx tasks.ts --dm",
        "previews": "tsx tools/generatePreviews.tsx",
        "gallery": "tsx tools/gallery.tsx",
        "check": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint -c eslint.config.mjs",
        "test": "mocha",
        "test:unit": "mocha test/core.test.ts --exit",
        "test:package": "mocha test/package.test.js --exit",
        "prepublishOnly": "npm run build",
        "release": "release-script",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes",
        "update-packages": "npx -y npm-check-updates --upgrade --workspaces --root",
        "npm": "npm i && cd src-widgets && npm i && cd ../src-dm-widgets && npm i && cd ../src-admin && npm i && cd ../src-preview && npm i",
        "build-admin": "tsx tasks.ts --admin",
        "dev": "npm run start --workspace=src-preview"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.flow/issues"
    },
    "readmeFilename": "README.md"
}
